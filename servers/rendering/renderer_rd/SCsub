from misc.utility.scons_hints import *

Import("env")

env.add_source_files(env.servers_sources, "*.cpp")

# Thirdparty source files

env_thirdparty = env.Clone()
env_thirdparty.disable_warnings()
env_thirdparty.add_source_files(env.servers_sources, "#thirdparty/fast_noise/fast_noise_vec2_64x64x32.cpp")

SConscript("effects/SCsub")
SConscript("environment/SCsub")
SConscript("storage_rd/SCsub")
if env["forward_plus_renderer"]:
    SConscript("forward_clustered/SCsub")
if env["forward_mobile_renderer"]:
    SConscript("forward_mobile/SCsub")
SConscript("shaders/SCsub")
SConscript("spirv-reflect/SCsub")
